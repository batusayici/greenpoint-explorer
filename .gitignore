# macOS
.DS_Store

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Future build outputs
node_modules/
dist/
build/
coverage/
.cache/
.vercel

# Visual-companion brainstorm artifacts
.superpowers/

# Playwright MCP scratch
.playwright-mcp/

# Asset-kit raw GPT renders (keyed outputs live in assets/inked/)
.scratch/

# Visual-baseline gate transients (committed baselines live in tests/visual-baselines/)
tests/.candidates/
tests/.diffs/

# Local agent worktrees (never commit)
.claude/worktrees/

# Track V ingest source snapshots (scripts/fetch-sources.mjs) — transient,
# except the *.ingested.txt diff baselines, which are tracked so cloud ingest
# runs can diff from a fresh checkout
.ingest-cache/*
!.ingest-cache/*.ingested.txt

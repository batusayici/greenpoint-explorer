{
  "name": "greenpoint-isometric-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"src/**/*.test.mjs\"",
    "verify:conformance": "node scripts/verify-visual-conformance.mjs",
    "verify:visual": "node scripts/verify-visual-baseline.mjs",
    "verify:components": "node scripts/verify-inked-component.mjs",
    "verify:stories": "node scripts/verify-place-stories.mjs",
    "verify": "npm run test && npm run verify:conformance && npm run verify:visual && npm run verify:components && npm run verify:stories"
  },
  "dependencies": {
    "pixi.js": "^8.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "vite": "^8.0.14"
  }
}

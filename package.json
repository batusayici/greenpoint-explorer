{
  "name": "stoopwise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-freshness.mjs --stamp && vite build && node scripts/prerender-aeo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "TZ=America/New_York node --test \"src/**/*.test.mjs\"",
    "ingest:fetch": "NODE_USE_ENV_PROXY=1 node scripts/fetch-sources.mjs",
    "ingest:expire": "node scripts/expire-cards.mjs",
    "ingest:geocode": "NODE_USE_ENV_PROXY=1 node scripts/geocode-demand-cards.mjs",
    "ingest:index": "node scripts/card-index.mjs",
    "board": "python3 scripts/asset_kit_board.py",
    "verify:conformance": "node scripts/verify-visual-conformance.mjs",
    "verify:visual": "node scripts/verify-visual-baseline.mjs",
    "verify:components": "node scripts/verify-inked-component.mjs",
    "verify:stories": "node scripts/verify-place-stories.mjs",
    "verify:kit-coverage": "node scripts/verify-kit-coverage.mjs",
    "verify:overrides": "node scripts/verify-facade-overrides.mjs",
    "verify": "npm run test && npm run verify:conformance && npm run verify:visual && npm run verify:components && npm run verify:stories && npm run verify:kit-coverage && npm run verify:overrides",
    "ingest:coverage": "node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "maplibre-gl": "^5.24.0",
    "pixi.js": "^8.18.1",
    "posthog-js": "^1.406.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "pixelmatch": "^7.2.0",
    "playwright": "1.56.0",
    "pngjs": "^7.0.0",
    "vite": "^8.0.14"
  }
}
